@namespace("ru.yandex.practicum.kafka.telemetry.event")
protocol SnapshotProtocol {

  record DeviceStateAvro {
    string id;
    union {null,
           ClimateSensorAvro,
           LightSensorAvro,
           MotionSensorAvro,
           SwitchSensorAvro,
           TemperatureSensorAvro} payload;
  }

  record SnapshotAvro {
    string hub_id;
    long timestamp;
    array<DeviceStateAvro> devices;
  }
}