{
  "namespace": "ru.yandex.practicum.kafka.telemetry.event",
  "protocol": "HubEventProtocol",
  "types": [
    {
      "type": "enum",
      "name": "DeviceTypeAvro",
      "symbols": ["MOTION_SENSOR", "TEMPERATURE_SENSOR", "LIGHT_SENSOR", "CLIMATE_SENSOR", "SWITCH_SENSOR"]
    },
    {
      "type": "enum",
      "name": "ConditionTypeAvro",
      "symbols": ["MOTION", "LUMINOSITY", "SWITCH", "TEMPERATURE", "CO2LEVEL", "HUMIDITY"]
    },
    {
      "type": "enum",
      "name": "ConditionOperationAvro",
      "symbols": ["EQUALS", "GREATER_THAN", "LOWER_THAN"]
    },
    {
      "type": "enum",
      "name": "ActionTypeAvro",
      "symbols": ["ACTIVATE", "DEACTIVATE", "INVERSE", "SET_VALUE"]
    },
    {
      "type": "record",
      "name": "DeviceAddedEventAvro",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "type", "type": "DeviceTypeAvro" }
      ]
    },
    {
      "type": "record",
      "name": "DeviceRemovedEventAvro",
      "fields": [
        { "name": "id", "type": "string" }
      ]
    },
    {
      "type": "record",
      "name": "ScenarioConditionAvro",
      "fields": [
        { "name": "sensor_id", "type": "string" },
        { "name": "type", "type": "ConditionTypeAvro" },
        { "name": "operation", "type": "ConditionOperationAvro" },
        { "name": "value", "type": ["null", "int", "boolean"], "default": null }
      ]
    },
    {
      "type": "record",
      "name": "DeviceActionAvro",
      "fields": [
        { "name": "sensor_id", "type": "string" },
        { "name": "type", "type": "ActionTypeAvro" },
        { "name": "value", "type": ["null", "int"], "default": null }
      ]
    },
    {
      "type": "record",
      "name": "ScenarioAddedEventAvro",
      "fields": [
        { "name": "name", "type": "string" },
        { "name": "conditions", "type": { "type": "array", "items": "ScenarioConditionAvro" } },
        { "name": "actions", "type": { "type": "array", "items": "DeviceActionAvro" } }
      ]
    },
    {
      "type": "record",
      "name": "ScenarioRemovedEventAvro",
      "fields": [
        { "name": "name", "type": "string" }
      ]
    },
    {
      "type": "record",
      "name": "HubEventAvro",
      "fields": [
        { "name": "hub_id", "type": "string" },
        { "name": "timestamp", "type": "long" },
        {
          "name": "payload",
          "type": [
            "null",
            "DeviceAddedEventAvro",
            "DeviceRemovedEventAvro",
            "ScenarioAddedEventAvro",
            "ScenarioRemovedEventAvro"
          ]
        }
      ]
    }
  ],
  "messages": {}
}